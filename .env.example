# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Use a Gmail App Password (Google Account → Security → 2-Step Verification →
# App passwords), NOT your normal Gmail password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
SENDER_NAME=Your Name
# Optional extra line after your contact details; the template already adds "Best regards,"
SENDER_SIGNATURE=

# true = run everything (scrape, match, queue, rules) but never send. Good for the first day.
DRY_RUN=false

# ── Resumes ───────────────────────────────────────────────────────────────────
# Folder containing .docx resumes directly; numbered subfolders are also supported
RESUMES_DIR=C:\Resumes
# Used only by the older numbered-subfolder layout
RESUME_FILE_NAME=Resume.docx

# ── Scraping ──────────────────────────────────────────────────────────────────
# How often to check nvoids for new postings (seconds). Don't go below 60.
POLL_SECONDS=60
# Max listing pages to walk back when catching up after downtime (~100 jobs/page)
MAX_CATCHUP_PAGES=3
# nvoids' clock is India time (UTC+5:30 = 330 minutes). Only change if "Priority" looks wrong.
NVOIDS_UTC_OFFSET_MINUTES=330

# ── Matching ──────────────────────────────────────────────────────────────────
# Best resume must score at least this (0-100) or no draft is made (logged as low_match)
MIN_MATCH_SCORE=40
# A JD naming fewer known skills than this is "thin": drafted with neutral wording + a warning
MIN_JD_SKILLS=4

# ── Sending pace ──────────────────────────────────────────────────────────────
# After each real send, wait a random time in this range before the next one
PACE_MIN_SECONDS=60
PACE_MAX_SECONDS=120
# Postings younger than this are PRIORITY: shown first and sent with the shorter gap below
PRIORITY_WINDOW_MINUTES=10
PRIORITY_PACE_MIN_SECONDS=50
PRIORITY_PACE_MAX_SECONDS=70
# After the daily cap, this many extra sends (random in range, fixed per day) are allowed for fresh postings only
FRESH_BUFFER_MIN=20
FRESH_BUFFER_MAX=30
# Most emails per day, even if you approve more (Gmail flags bursts)
DAILY_SEND_CAP=200

# ── Vendor rules ──────────────────────────────────────────────────────────────
# Most emails to one address per calendar week (resets Monday 00:00); extra ones are held
MAX_PER_RECIPIENT_PER_WEEK=3
# Same vendor + same job title within this many days = repost (held)
DUPLICATE_WINDOW_DAYS=30
# Same vendor + JD at least this similar (0-1) within this many hours = repost (held)
REPOST_SIMILARITY=0.70
REPOST_COOLDOWN_HOURS=3
# Warn when someone else at the same company got a different resume within this many days
COMPANY_CONFLICT_DAYS=30
# Warn when you emailed the same recruiter within this many days
RECRUITER_COOLDOWN_DAYS=3

# ── Dashboard ─────────────────────────────────────────────────────────────────
PORT=7892

# ── Email signature ──────────────────────────────────────────────────────────
# Shown under your name ("Phone: …", "Email: …"); SENDER_YEARS fills "I bring 10+ years of …"
SENDER_PHONE=
SENDER_EMAIL=
SENDER_YEARS=10+

# ── CC ────────────────────────────────────────────────────────────────────────
# CC'd on every recruiter email (comma-separated for more than one). Not on the test email.
CC_EMAILS=

# ── Daily cap ramp (optional) ───────────────────────────────────────────────────
# Start at DAILY_SEND_CAP on this date, add STEP every N days, never above MAX. STEP=0 = fixed cap.
DAILY_CAP_RAMP_START=
DAILY_CAP_RAMP_STEP=0
DAILY_CAP_RAMP_EVERY_DAYS=2
DAILY_CAP_MAX=200

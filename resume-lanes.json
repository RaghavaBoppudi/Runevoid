{
  "_help": "How Runevoid picks a resume (edits apply without a restart). Every resume gets a damage score anchored to weighted JD skill coverage. Stack evidence can adjust the score by at most 10% downward; family resistance can penalize a mismatched lane; senior/lead evidence and curated-folder factors are bounded. The final score is capped at JD keyword coverage, so no bonus can hide missing skills. Named resume files use their curated filename for family inference; configured numbered-folder families remain authoritative. Near-ties use local semantic similarity. Resume IDs are filenames without .docx for files directly in RESUMES_DIR, or folder numbers for legacy numbered subfolders. IDs in ignore are never used.",
  "default": "",
  "margin": 8,
  "tie_gap": 3,
  "custom": [],
  "seniority": 1.0,
  "ignore": ["16"],

  "families": {
    "ai":    ["1", "2", "8", "9", "12", "14", "15"],
    "ds":    ["3", "4"],
    "java":  ["5", "7"],
    "cloud": ["6", "17"],
    "gov":   ["10", "11"],
    "po":    ["13"]
  },

  "_job_families_help": "Which family a job belongs to, decided from its title. A title can name several (\"Java Lead [AI driven]\" = java + ai, and the resume's smallest clash counts) unless one is listed in `exclusive`, which then wins alone. A job that matches none gets no wrong-lane penalty.",
  "exclusive": ["gov", "po"],
  "job_families": [
    ["ds",    ["data scientist", "data science", "applied scientist", "research scientist", "decision scientist"]],
    ["gov",   ["ai governance", "responsible ai", "model risk", "ai risk", "ai review", "ai ethics", "ai assurance", "ai compliance", "governance architect", "governance consultant"]],
    ["po",    ["product owner"]],
    ["ai",    ["ai", "a i", "ml", "machine learning", "llm", "genai", "gen ai", "generative ai", "agentic", "mlops", "llmops", "nlp", "computer vision", "deep learning", "rag", "ai ml", "artificial intelligence", "chatbot", "conversational ai", "copilot", "mcp"]],
